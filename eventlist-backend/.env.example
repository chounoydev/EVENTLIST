# Eventlist TypeScript API - local development
NODE_ENV=development
PORT=8000

# PostgreSQL database created in pgAdmin.
# Replace YOUR_POSTGRES_PASSWORD with the password for your local PostgreSQL user.
DATABASE_URL="postgres://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/eventlist?sslmode=disable"
DATABASE_URL_UNPOOLED="postgres://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/eventlist?sslmode=disable"

# Initial portal owner (used by: npm run owner:create)
OWNER_EMAIL=johndegamo45@gmail.com
OWNER_NAME=
OWNER_PASSWORD=

# Frontend/API origins used for generated URLs and CORS.
PUBLIC_API_URL=http://127.0.0.1:8000
APP_PUBLIC_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1,capacitor://localhost,https://localhost

# Uploaded event images are saved here.
UPLOAD_DIR=./uploads

# Optional: configure these only to enable password-reset email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Eventlist <no-reply@example.com>"